@echo off
REM Claude Code drop-in shim backed by pi (drop-in for hapi/Claude Code).
REM
REM AUTO-GENERATED by pi-claude-shim/install.js. Forwards all args to
REM the shim's Node.js entry script in the source tree.

setlocal

REM SHIM_BIN points to the absolute path of the source `bin\claude.js`
REM so that --version, --print, --output-format stream-json etc. all
REM proxy through to the same handler.
set "SHIM_BIN=__SHIM_BIN_PLACEHOLDER__"

where /Q node >nul 2>&1
if errorlevel 1 (
  echo pi-claude-shim: node not found on PATH 1>&2
  exit /b 1
)

node "%SHIM_BIN%" %*
endlocal
